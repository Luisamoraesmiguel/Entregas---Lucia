def alterar_status():
    id_pedido = input(">>> Digite o ID do pedido: ").strip()
    pedido = buscar_pedido_por_id(id_pedido)

    if pedido is None:
        print(">>> Pedido não encontrado.")
        return

    if pedido["status"] == "Cancelado":
        print(">>> Pedido cancelado não pode ter status alterado.")
        return

    print(f">>> Status atual: {pedido['status']}")
    print(" 1 - Pendente")
    print(" 2 - Em Rota")
    print(" 3 - Entregue")
    opcao = input(">>> Novo status: ")

    if opcao == "1":
        if pedido["id_entregador"] is not None:
            entregador = buscar_entregador_por_id(pedido["id_entregador"])
            if entregador is not None:
                if pedido["id"] in entregador["pedidos_ativos"]:
                    entregador["pedidos_ativos"].remove(pedido["id"])
                if len(entregador["pedidos_ativos"]) == 0:
                    entregador["disponibilidade"] = "Disponível"
            pedido["id_entregador"] = None
        pedido["status"] = "Pendente"

    elif opcao == "2":
        pedido["status"] = "Em Rota"

    elif opcao == "3":
        pedido["status"] = "Entregue"
        if pedido["id_entregador"] is not None:
            entregador = buscar_entregador_por_id(pedido["id_entregador"])
            if entregador is not None:
                if id_pedido in entregador["pedidos_ativos"]:
                    entregador["pedidos_ativos"].remove(id_pedido)
                entregador["historico_entregas"].append(id_pedido)
                if len(entregador["pedidos_ativos"]) == 0:
                    entregador["disponibilidade"] = "Disponível"
    else:
        print(">>> Opção inválida.")
        return

    print(f">>> Status do pedido {id_pedido} atualizado para: {pedido['status']}")


def cancelar_pedido():
    id_pedido = input(">>> Digite o ID do pedido a cancelar: ").strip()
    pedido = buscar_pedido_por_id(id_pedido)

    if pedido is None:
        print(">>> Pedido não encontrado.")
        return

    if pedido["status"] == "Cancelado":
        print(">>> Este pedido já está cancelado. Pedidos cancelados não podem ser reativados.")
        return

    if pedido["status"] == "Entregue":
        print(">>> Pedido já foi entregue. Não é possível cancelar.")
        return

    if pedido["id_entregador"] is not None:
        entregador = buscar_entregador_por_id(pedido["id_entregador"])
        if entregador is not None:
            if id_pedido in entregador["pedidos_ativos"]:
                entregador["pedidos_ativos"].remove(id_pedido)
            if len(entregador["pedidos_ativos"]) == 0:
                entregador["disponibilidade"] = "Disponível"
        pedido["id_entregador"] = None

    pedido["status"] = "Cancelado"
    print(f">>> Pedido {id_pedido} cancelado com sucesso.")


def associar_entregador():
    id_pedido = input(">>> Digite o ID do pedido: ").strip()
    pedido = buscar_pedido_por_id(id_pedido)

    if pedido is None:
        print(">>> Pedido não encontrado.")
        return

    if pedido["status"] == "Cancelado" or pedido["status"] == "Entregue":
        print(f">>> Não é possível associar entregador a um pedido com status '{pedido['status']}'.")
        return

    if pedido["id_entregador"] is not None:
        print(f">>> Este pedido já possui o entregador {pedido['id_entregador']} associado.")
        return

    id_entregador = input(">>> Digite o ID do entregador: ").strip()
    entregador = buscar_entregador_por_id(id_entregador)

    if entregador is None:
        print(">>> Entregador não encontrado.")
        return

    limite = limite_por_veiculo(entregador["veiculo"])
    if len(entregador["pedidos_ativos"]) >= limite:
        print(f">>> Este entregador já atingiu o limite de {limite} pedidos ativos ({entregador['veiculo']}).")
        return

    pedido["id_entregador"] = id_entregador
    entregador["pedidos_ativos"].append(id_pedido)
    entregador["disponibilidade"] = "Indisponível"
    pedido["status"] = "Em Rota"

    print(f">>> Entregador {entregador['nome']} associado ao pedido {id_pedido} com sucesso!")


def remover_entregador():
    id_pedido = input(">>> Digite o ID do pedido: ").strip()
    pedido = buscar_pedido_por_id(id_pedido)

    if pedido is None:
        print(">>> Pedido não encontrado.")
        return

    if pedido["id_entregador"] is None:
        print(">>> Este pedido não possui entregador associado.")
        return

    entregador = buscar_entregador_por_id(pedido["id_entregador"])
    if entregador is not None:
        if id_pedido in entregador["pedidos_ativos"]:
            entregador["pedidos_ativos"].remove(id_pedido)
        if len(entregador["pedidos_ativos"]) == 0:
            entregador["disponibilidade"] = "Disponível"

    pedido["id_entregador"] = None
    pedido["status"] = "Pendente"
    print(f">>> Entregador removido do pedido {id_pedido}. Status voltou para Pendente.")


