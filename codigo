def entregas_por_entregador():
    id_entregador = input(">>> Digite o ID do entregador: ").strip()
    entregador = buscar_entregador_por_id(id_entregador)

    if entregador is None:
        print(">>> Entregador não encontrado.")
        return

    print(f"\n>>> Entregas realizadas por {entregador['nome']}:")
    encontrou = False
    for id_p in entregador["historico_entregas"]:
        pedido = buscar_pedido_por_id(id_p)
        if pedido is not None:
            encontrou = True
            print(f"   ID: {pedido['id']} | Cliente: {pedido['nome_cliente']} | Endereço: {pedido['endereco']}")
    if not encontrou:
        print("   Nenhuma entrega concluída por este entregador.")

def gerar_relatorio():
    print("\n---------- RELATÓRIO OPERACIONAL ----------")

    total = len(pedidos)
    print(f"\n>>> Total de pedidos cadastrados: {total}")

    if total == 0:
        print(">>> Nenhum pedido cadastrado ainda.")
        return

    cont_pendente = 0
    cont_em_rota = 0
    cont_entregue = 0
    cont_cancelado = 0
    cont_alta = 0

    for pedido in pedidos:
        if pedido["status"] == "Pendente":
            cont_pendente += 1
        elif pedido["status"] == "Em Rota":
            cont_em_rota += 1
        elif pedido["status"] == "Entregue":
            cont_entregue += 1
        elif pedido["status"] == "Cancelado":
            cont_cancelado += 1

        if pedido["prioridade"] == "Alta":
            cont_alta += 1

    print(f"\n>>> Pedidos por status:")
    print(f"   Pendente:   {cont_pendente}")
    print(f"   Em Rota:    {cont_em_rota}")
    print(f"   Entregue:   {cont_entregue}")
    print(f"   Cancelado:  {cont_cancelado}")

    print(f"\n>>> Pedidos com Alta Prioridade: {cont_alta}")

    print(f"\n>>> Entregador com mais entregas concluídas:")
    maior = 0
    nome_top = "Nenhum"

    for entregador in entregadores:
        cont = len(entregador["historico_entregas"])
        if cont > maior:
            maior = cont
            nome_top = entregador["nome"]

    if maior == 0:
        print("   Nenhuma entrega concluída ainda.")
    else:
        print(f"   {nome_top} com {maior} entrega(s) concluída(s).")

    print("\n==========================================")

