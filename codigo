def gerar_id_pedido():
    letra = "P"
    numero = random.randint(1000, 9999)
    while (letra + str(numero)) in ids_pedidos_usados:
        numero = random.randint(1000, 9999)
    id_gerado = letra + str(numero)
    ids_pedidos_usados.append(id_gerado)
    return id_gerado

def gerar_id_entregador():
    numero = random.randint(1000, 9999)
    while str(numero) in ids_entregadores_usados:
        numero = random.randint(1000, 9999)
    id_gerado = str(numero)
    ids_entregadores_usados.append(id_gerado)
    return id_gerado


def buscar_pedido_por_id(id_pedido):
    for pedido in pedidos:
        if pedido["id"] == id_pedido:
            return pedido
    return None


def limite_por_veiculo(veiculo):
    if veiculo == "Moto":
        return 2
    elif veiculo == "Carro":
        return 4
    elif veiculo == "Van":
        return 6
    return 2


def buscar_entregador_por_id(id_entregador):
    for entregador in entregadores:
        if entregador["id"] == id_entregador:
            return entregador
    return None


