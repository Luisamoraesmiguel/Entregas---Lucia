def listar_pedidos_por_status(status_filtro):
    print(f"\n>>> Pedidos com status '{status_filtro}':")
    encontrou = False

    lista_alta = []
    lista_normal = []
    for p in pedidos:
        if p["prioridade"] == "Alta":
            lista_alta.append(p)
        else:
            lista_normal.append(p)
    lista_ordenada = lista_alta + lista_normal

    for pedido in lista_ordenada:
        if pedido["status"] == status_filtro:
            encontrou = True
            print(f"   ID: {pedido['id']} | Cliente: {pedido['nome_cliente']} | Endereço: {pedido['endereco']} | Prioridade: {pedido['prioridade']}")

    if not encontrou:
        print("   Nenhum pedido encontrado.")


def buscar_pedido():
    id_pedido = input(">>> Digite o ID do pedido: ").strip()
    pedido = buscar_pedido_por_id(id_pedido)

    if pedido is None:
        print(">>> Pedido não encontrado.")
        return

    print("\n>>> DADOS DO PEDIDO:")
    print(f"   ID:           {pedido['id']}")
    print(f"   Cliente:      {pedido['nome_cliente']}")
    print(f"   Endereço:     {pedido['endereco']}")
